# Backend HTTP API URL
# For Android Emulator: http://10.0.2.2:8000/api/v1
# For iOS Simulator / Localhost: http://127.0.0.1:8000/api/v1
# For Production / Public Tunnel: https://api.yourdomain.com/api/v1
API_BASE_URL=http://10.0.2.2:8000/api/v1

# Laravel Reverb WebSocket Server Settings
REVERB_APP_KEY=chatapp_key
REVERB_HOST=10.0.2.2
REVERB_PORT=8080
REVERB_SCHEME=http

# STUN / TURN Servers for WebRTC NAT Traversal
STUN_SERVER_1=stun:stun.l.google.com:19302
STUN_SERVER_2=stun:stun1.l.google.com:19302
